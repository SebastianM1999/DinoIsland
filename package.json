{
  "name": "dinosaur-island",
  "version": "0.1.0",
  "description": "Dinosaur Island – a small 1–4 player co-op first-person dinosaur hunting demo (Three.js + Node.js WebSocket server).",
  "type": "module",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test",
    "desktop": "electron .",
    "build:win": "electron-builder --win dir",
    "verify:steam": "node scripts/verify-steam.cjs",
    "build:steam": "npm run verify:steam && electron-builder --win dir"
  },
  "build": {
    "appId": "com.dinosaurisland.game",
    "productName": "Dinosaur Island",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "server/**/*",
      "src/**/*",
      "css/**/*",
      "assets/**/*",
      "index.html",
      "package.json"
    ],
    "asarUnpack": ["node_modules/koffi/**/*", "node_modules/steamworks-ffi-node/prebuilds/**/*"],
    "extraResources": [
      { "from": ".", "to": ".", "filter": ["steamworks_sdk/redistributable_bin/win64/steam_api64.dll"] },
      { "from": "node_modules/three/examples/jsm", "to": "three-addons", "filter": ["**/*"] }
    ],
    "win": {
      "target": "dir"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "steamworks-ffi-node": "0.11.3",
    "three": "^0.180.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  }
}
